{
  "name": "@luzia/cli",
  "version": "0.0.0",
  "description": "luzIA command line: compile a Knowledge Base and run evals",
  "license": "MIT",
  "type": "module",
  "bin": {
    "luzia": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "publishConfig": {
    "bin": {
      "luzia": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@luzia/core": "workspace:*",
    "ai": "^7.0.182",
    "zod": "^4.6.7"
  }
}
