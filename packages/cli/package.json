{
  "name": "@luzia/cli",
  "version": "0.1.0",
  "description": "luzIA command line: set up luzIA, compile a Knowledge Base and run evals",
  "license": "MIT",
  "type": "module",
  "bin": {
    "luzia": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bin": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "luzia": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./bin": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@luzia/core": "workspace:^",
    "ai": "^7.0.182",
    "zod": "^4.6.7"
  },
  "keywords": [
    "luzia",
    "portfolio",
    "ai-agent",
    "cli",
    "setup"
  ]
}
