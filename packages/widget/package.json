{
  "name": "luzia-widget",
  "version": "0.1.1",
  "description": "Embeddable luzIA chat widget (framework-free Web Component)",
  "license": "MIT",
  "author": "Sergio Deri <sergio.deri@astrocode.uy>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergioDeri/luzia.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/SergioDeri/luzia/tree/main/packages/widget#readme",
  "bugs": {
    "url": "https://github.com/SergioDeri/luzia/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./script": "./dist/luzia-widget.js"
  },
  "unpkg": "./dist/luzia-widget.js",
  "jsdelivr": "./dist/luzia-widget.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./script": "./dist/luzia-widget.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm build:script",
    "build:script": "node scripts/build-script-bundle.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4"
  },
  "keywords": [
    "luzia",
    "portfolio",
    "chat-widget",
    "web-component"
  ]
}
