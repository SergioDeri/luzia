# Chat model used by luzIA (server-side only; never exposed to the browser).
LUZIA_CHAT_PROVIDER=anthropic   # anthropic | openai | google
LUZIA_CHAT_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Embeddings model used to search the Knowledge Base, chosen separately from the
# chat model (Anthropic has no embeddings API). Required by `luzia build` and the
# server once knowledge-base/ holds markdown files besides core.md and
# instructions.md; a Core-only Knowledge Base needs none. Build and server must
# use the same model, or the server refuses to start. The provider's API key
# (OPENAI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY) must be set as well.
# LUZIA_EMBEDDING_PROVIDER=openai   # openai | google
# LUZIA_EMBEDDING_MODEL=text-embedding-3-small
