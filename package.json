{
  "name": "luzia-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "build": "pnpm -r --workspace-concurrency=1 --filter './packages/*' build",
    "pack:local": "pnpm build && pnpm --filter \"./packages/*\" exec pnpm pack --pack-destination ../../.luzia-packs",
    "release": "pnpm build && pnpm --filter \"./packages/*\" publish --access public"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
